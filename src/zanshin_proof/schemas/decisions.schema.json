{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zanshin.dev/schemas/proof/decisions-v1.schema.json",
  "title": "Zanshin Proof Binary Decisions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "provenance",
    "facts",
    "evaluation",
    "records"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "provenance": {
      "$ref": "https://zanshin.dev/schemas/proof/evidence-v1.schema.json#/$defs/provenance"
    },
    "facts": {
      "type": "object"
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bin_count",
        "automation_threshold"
      ],
      "properties": {
        "bin_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "automation_threshold": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "probability",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "label": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "baseline_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
